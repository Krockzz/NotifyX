
enum DeadLetterStatus {
  PENDING
  REPLAYED
  RESOLVED
}

enum ChannelType {
  EMAIL
  SMS
  PUSH
  WEBHOOK
}

enum NotificationStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
}



datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}


model User {
  id            String   @id @default(uuid())
  UserName      String   @db.VarChar(50)
  email         String   @unique @db.VarChar(255)
  password      String   @db.VarChar(255)
  refreshTokens String?  @db.VarChar(200)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  applications Application[]
}


model Application {
  id         String   @id @default(uuid())
  userId     String
  appName    String   @db.VarChar(255)
  isActive   Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation( fields: [userId], references: [id], onDelete: Cascade )

  apiKeys      ApiKey[]
  events       Event[]
  eventTypes   EventType[]
  entityGrps   EntityGrp[]
  auditEntries AuditLedger[]
}


model ApiKey {
  id            String   @id @default(uuid())
  applicationId String
  name          String   @db.VarChar(100)
  keyPrefix     String   @db.VarChar(20)
  keyHash       String   @unique @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  expiresAt     DateTime?

  application Application @relation(  fields: [applicationId], references: [id], onDelete: Cascade)

  events Event[]

  @@index([applicationId, revokedAt])
  @@index([applicationId, createdAt])
}


model EntityGrp {
  id           String   @id @default(uuid())
  appId        String
  name         String   @db.VarChar(100)
  entityIdPath String   @db.VarChar(255)
  description  String?  @db.Text
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  application Application @relation( fields: [appId], references: [id],onDelete: Cascade)

  eventTypes EventType[]

  @@unique([appId, id])
  @@unique([appId, name])
  @@index([appId])
}


model EventType {
  id          String   @id @default(uuid())
  appId       String
  eventCode   String   @db.VarChar(50)
  entityGrpId String?

  description String?  @db.Text
  isActive    Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  application Application @relation(fields: [appId],  references: [id],  onDelete: Restrict )

  entityGrp EntityGrp? @relation(fields: [appId, entityGrpId], references: [appId, id], onDelete: Restrict )

  events    Event[]
  channels  EventTypeChannel[]
  templates Template[]

  @@unique([appId, id])
  @@unique([appId, eventCode])
}


model Event {
  id          String   @id @default(uuid())
  appId       String
  eventTypeId String

  apiKeyId String?

  routingKey String? @db.VarChar(255)

  payload    Json
  created_at DateTime @default(now())

  application Application @relation( fields: [appId], references: [id],onDelete: Restrict )

  eventType EventType @relation( fields: [appId, eventTypeId],  references: [appId, id], onDelete: Restrict )

  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull )

  notifications Notification[]
  auditEntries  AuditLedger[]

  @@index([appId, created_at])
  @@index([eventTypeId, created_at])
  @@index([apiKeyId])
}


model EventTypeChannel {
  id            String      @id @default(uuid())
  eventTypeId   String
  channelType   ChannelType
  recipientPath String?     @db.VarChar(255)
  isEnabled     Boolean     @default(true)
  created_at    DateTime    @default(now())

  eventType EventType @relation( fields: [eventTypeId], references: [id], onDelete: Cascade )

  @@unique([eventTypeId, channelType])
}



model Template {
  id          String      @id @default(uuid())
  eventTypeId String
  channelType ChannelType
  subject     String?     @db.VarChar(255)
  bodyContent String      @db.Text
  isActive    Boolean     @default(true)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  eventType EventType @relation(    fields: [eventTypeId], references: [id], onDelete: Cascade )


  notifications Notification[]

  @@unique([eventTypeId, channelType])
}


model Notification {
  id              String             @id @default(uuid())
  eventId          String
  templateId       String
  channelType      ChannelType
  recipientTarget  String             @db.VarChar(255)

  subject          String?            @db.VarChar(255)
  bodyContent      String             @db.Text

  status           NotificationStatus @default(PENDING)
  scheduledAt      DateTime?

  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict  )

  template Template @relation(fields: [templateId],references: [id], onDelete: Restrict  )

  deliveryAttempts DeliveryAttempt[]
  auditEntries     AuditLedger[]
  deadLetter       DeadLetter?

  @@index([status, created_at])
  @@index([eventId])

  @@unique([eventId, channelType])
}


model DeliveryAttempt {
  id                String        @id @default(uuid())
  notificationId    String
  attemptNumber     Int
  provider          String        @db.VarChar(100)
  status            DeliveryStatus
  providerMessageId String?       @db.VarChar(255)
  errorReason       String?       @db.Text

  created_at     DateTime  @default(now())
  nextRetryAt    DateTime?
  retryClaimedAt DateTime?

  notification Notification @relation(fields: [notificationId],references: [id],onDelete: Cascade )

  @@unique([notificationId, attemptNumber])
}


model OutboxEvent {
  id      String @id @default(uuid())
  topic   String @db.VarChar(255)
  messageKey String @db.VarChar(255) // this one would act as the routing key here
  payload Json

  status OutboxStatus @default(PENDING)

  retryCount  Int       @default(0)
  nextRetryAt DateTime?

  created_at   DateTime  @default(now())
  claimed_at   DateTime?
  published_at DateTime?

  @@index([status, nextRetryAt, created_at])
}

// ================================
// AUDIT LEDGER
// ================================

model AuditLedger {
  id             String   @id @default(uuid())
  appId          String
  eventId        String?
  notificationId String?

  action     String   @db.VarChar(100)
  status     String   @db.VarChar(50)
  metadata   Json?
  created_at DateTime @default(now())

  application Application @relation(    fields: [appId], references: [id],onDelete: Restrict )

  event Event? @relation(fields: [eventId], references: [id], onDelete: Restrict )

  notification Notification? @relation(fields: [notificationId], references: [id],  onDelete: Restrict )

  @@index([appId, created_at])
  @@index([eventId, created_at])
  @@index([notificationId, created_at])
}

// ================================
// DEAD LETTER
// ================================

model DeadLetter {
  id             String      @id @default(uuid())
  appId          String
  eventId        String
  notificationId String

  channelType  ChannelType
  attemptCount Int
  reason       String      @db.VarChar(100)
  lastError    String?     @db.Text

  status      DeadLetterStatus @default(PENDING)
  metadata    Json?

  created_at  DateTime  @default(now())
  resolved_at DateTime?

  notification Notification @relation(  fields: [notificationId], references: [id],  onDelete: Restrict  )

  // One dead-letter record per notification.
  @@unique([notificationId])
  @@index([appId, created_at])
  @@index([eventId])
  @@index([status, created_at])
}